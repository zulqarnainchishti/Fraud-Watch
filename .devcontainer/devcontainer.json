{
  "name": "Hadoop HDFS Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "default",
      "installMaven": false
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-hadoop.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
